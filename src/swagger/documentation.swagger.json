{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Node.js and TypeScript Backend Starter Kit",
    "description": "Welcome to the Node.js and TypeScript Backend Starter Kit! This repository provides a robust foundation for building scalable and maintainable backend applications using Node.js and TypeScript. Perfect for developers looking to kickstart new projects without the repetitive setup tasks."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Development Server"
    }
  ],
  "tags": [
    {
      "name": "Stellar",
      "description": "Sytemap Stellar Blockchain API Endpoints"
    }
  ],
  "paths": {
    "/welcome": {
      "get": {
        "tags": [
          "Welcome"
        ],
        "summary": "Welcome API Endpoint to start",
        "description": "",
        "responses": {
          "200": {
            "description": "Some description...",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucess": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Welcome to Sytemap Blockchain Backend Service"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sucess": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Welcome to Sytemap Blockchain Backend Service"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/benchmark": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "requests",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/create_stellar_account": {
      "post": {
        "tags": [
          "Stellar"
        ],
        "description": "Generate a mnemonic phrase, derive a keypair from it, create a new Stellar account, and return account details including the mnemonic",
        "operationId": "create_stellar_account",
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "UserId",
                  "UserEmail",
                  "Username",
                  "DeveloperId",
                  "BlockchainType",
                  "BlockchainAction"
                ],
                "properties": {
                  "UserId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "UserEmail": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "Username": {
                    "type": "string",
                    "minLength": 1,
                    "example": "testuser"
                  },
                  "DeveloperId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "BlockchainType": {
                    "type": "string",
                    "enum": [
                      "STELLAR"
                    ],
                    "example": "STELLAR"
                  },
                  "BlockchainAction": {
                    "type": "string",
                    "enum": [
                      "CREATE"
                    ],
                    "example": "CREATE"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/send_syte_tokens": {
      "post": {
        "tags": [
          "Stellar"
        ],
        "description": "Send SYTE tokens to a specified wallet address",
        "operationId": "send_syte_tokens",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "UserId",
                  "DeveloperId",
                  "WalletAddress",
                  "AmountPaid"
                ],
                "properties": {
                  "UserId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "DeveloperId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "WalletAddress": {
                    "type": "string",
                    "example": "GBMYWRUGENOVBAZUN2HAOHOREMPNKQBVSLIBEBTLIBSL4Y4JTWPALGHQ"
                  },
                  "AmountPaid": {
                    "type": "number",
                    "minimum": 0,
                    "example": 100
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_stellar_wallet": {
      "get": {
        "tags": [
          "Stellar"
        ],
        "description": "Get wallet details and balances for a Stellar wallet address",
        "operationId": "get_stellar_wallet",
        "parameters": [
          {
            "name": "walletAddress",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/get_stellar_transaction_history": {
      "get": {
        "tags": [
          "Stellar"
        ],
        "description": "Get all transaction history for a Stellar wallet address",
        "operationId": "get_stellar_transaction_history",
        "parameters": [
          {
            "name": "walletAddress",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/activate_syte_token_trustline": {
      "post": {
        "tags": [
          "Stellar"
        ],
        "description": "Admin function to activate SYTE token trustline for a wallet address. IMPORTANT: Only use this function if you are certain that the account already exists on the Stellar network and only lacks the SYTE token trustline activation. This function will fail if the account does not exist on-chain.",
        "operationId": "activate_syte_token_trustline",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "WalletAddress",
                  "EncryptedSecretKey"
                ],
                "properties": {
                  "WalletAddress": {
                    "type": "string",
                    "example": "GBMYWRUGENOVBAZUN2HAOHOREMPNKQBVSLIBEBTLIBSL4Y4JTWPALGHQ",
                    "description": "Stellar wallet address (public key)"
                  },
                  "EncryptedSecretKey": {
                    "type": "string",
                    "example": "encrypted-secret-key-here",
                    "description": "Encrypted secret key for the wallet"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/send_syteplot_nft": {
      "post": {
        "tags": [
          "Stellar"
        ],
        "description": "Send SYTEPLOT NFT to a specified wallet address. This function will automatically add the trustline (if needed) and send the NFT (0.0000001 tokens) in one operation. The wallet address and encrypted secret key are provided in the Metadata object (buyer_wallet_id and buyer_wallet_secret).",
        "operationId": "send_syteplot_nft",
        "responses": {
          "200": {
            "description": "SYTEPLOT NFT sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "UserId": {
                          "type": "integer",
                          "example": 1
                        },
                        "PlotId": {
                          "type": "integer",
                          "example": 1
                        },
                        "TransactionHash": {
                          "type": "string",
                          "example": "8584e10abb99159e9bf86d1718599fae4ac3a73332aa7b6d02a43bcff09c4812"
                        },
                        "metadataUrl": {
                          "type": "string",
                          "example": "https://stellar.expert/explorer/testnet/tx/8584e10abb99159e9bf86d1718599fae4ac3a73332aa7b6d02a43bcff09c4812"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "UserId",
                  "PlotId",
                  "Metadata"
                ],
                "properties": {
                  "UserId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "PlotId": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 1
                  },
                  "Metadata": {
                    "type": "object",
                    "required": [
                      "buyer_wallet_id",
                      "buyer_wallet_secret"
                    ],
                    "properties": {
                      "plot_no": {
                        "type": "integer",
                        "example": 123
                      },
                      "estate_name": {
                        "type": "string",
                        "example": "Sunset Estate"
                      },
                      "size_of_plot": {
                        "type": "number",
                        "example": 500.5
                      },
                      "plot_url": {
                        "type": "string",
                        "example": "https://example.com/plot/123"
                      },
                      "price_of_plot": {
                        "type": "number",
                        "example": 100000
                      },
                      "date_of_allocation": {
                        "type": "string",
                        "format": "date",
                        "example": "2024-01-15"
                      },
                      "coordinate_of_plot": {
                        "type": "string",
                        "example": "40.7128,-74.0060"
                      },
                      "buyer_wallet_id": {
                        "type": "string",
                        "example": "GBMYWRUGENOVBAZUN2HAOHOREMPNKQBVSLIBEBTLIBSL4Y4JTWPALGHQ"
                      },
                      "buyer_wallet_secret": {
                        "type": "string",
                        "example": "encrypted-secret-key-here"
                      },
                      "estate_company_name": {
                        "type": "string",
                        "example": "ABC Real Estate"
                      },
                      "property_verification_no": {
                        "type": "integer",
                        "example": 12345
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}