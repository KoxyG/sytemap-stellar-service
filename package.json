{
  "name": "sytemap-blockchain-backend",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Progress ochuko Eyaadah - Koxy",
  "license": "MIT",
  "scripts": {
    "build": "npm run swagger && tsc && npm run build:copy",
    "swagger": "ts-node ./src/swagger/swagger.ts",
    "build:copy": "mkdir -p dist/public && cp -r public/* dist/public/ 2>/dev/null || true && mkdir -p dist/swagger && cp -r src/swagger/*.json dist/swagger/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "dev": "nodemon --config nodemon.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "prepare": "node -e \"if(process.env.NODE_ENV !== 'production') require('husky').install()\" || true",
    "lint-staged": "yarn run format && yarn run lint:fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:key": "ts-node scripts/generate-encryption-key.ts",
    "create:account": "ts-node scripts/create-and-encrypt-account.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.3.2",
    "@types/express": "^4.17.21",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "stellar-hd-wallet": "^1.0.2",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.5.4",
    "winston": "^3.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.2.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/parser": "^8.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^50.0.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.8",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.5",
    "typescript-eslint": "^8.1.0"
  }
}
